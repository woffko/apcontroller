#!/bin/sh

#
# (c) 2025 Cezary Jackiewicz <cezary@eko.one.pl>
#

SEC=$1
[ -z "$SEC" ] && exit 0

VERBOSE=$2

. /usr/share/libubox/jshn.sh

BASEPATH="/tmp/apcontroller"
# Command files carry Wi-Fi passphrases: root-only here, and scp carries the
# mode over, so they land root-only on the access point as well.
umask 077
DBCLIENT_HOME="/etc/apcontroller"
KNOWN_HOSTS="${DBCLIENT_HOME}/.ssh/known_hosts"
# The state directory lives under /tmp. Refuse to use it when a link or a
# directory of another account sits there: whoever owns the directory could
# replace the status files that are read and acted on as root.
ensure_basepath() {
	if [ -L "$BASEPATH" ]; then
		log_apcontroller "refusing $BASEPATH: it is a symbolic link"
		exit 1
	fi
	mkdir -p "$BASEPATH" || exit 1
	if [ ! -d "$BASEPATH" ] || [ "$(stat -c '%u' "$BASEPATH" 2>/dev/null)" != "0" ]; then
		log_apcontroller "refusing $BASEPATH: not a directory owned by root"
		exit 1
	fi
	chmod 700 "$BASEPATH"
}

ensure_basepath
mkdir -p "$DBCLIENT_HOME/.ssh"
chmod 700 "$DBCLIENT_HOME" "$DBCLIENT_HOME/.ssh"
touch "$KNOWN_HOSTS"
chmod 600 "$KNOWN_HOSTS"

log_apcontroller() {
	logger -t apcontroller-sendconfig "$*"
}

default_keyfile() {
	echo "/etc/apcontroller/keys/id_apc_$1"
}

normalize_keyfile() {
	local keyfile="$2"

	[ -n "$keyfile" ] && echo "$keyfile" || echo "/root/.ssh/id_dropbear"
}

valid_host() {
	[ -n "$1" ] && printf '%s\n' "$1" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._:-]*$'
}

valid_username() {
	[ -n "$1" ] && printf '%s\n' "$1" | grep -Eq '^[A-Za-z0-9_][A-Za-z0-9._-]*$'
}

valid_port() {
	case "$1" in ""|*[!0-9]*) return 1 ;; esac
	[ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

valid_keyfile() {
	[ -n "$1" ] && printf '%s\n' "$1" | grep -Eq '^(/etc/apcontroller/keys|/root/\.ssh)/[A-Za-z0-9._-]+$'
}

T=$(uci -q get apcontroller."$SEC")
[ "x$T" = "xgroup" ] || exit 0

HOSTS=$(uci -q get apcontroller."$SEC".host)
[ -z "$HOSTS" ] && exit 0
WIFIS=$(uci -q get apcontroller."$SEC".wifi)
[ -z "$WIFIS" ] && exit 0

json_init

DELETE=$(uci -q get apcontroller."$SEC".delete)
[ "x$DELETE" = "x1" ] && json_add_int "delete" 1

json_add_array "wifis"
for WIFI in $WIFIS; do
	BANDS="$(uci -q get apcontroller."$WIFI".band)"
	for BAND in $BANDS; do
		json_add_object
		json_add_int "enabled" "$(uci -q get apcontroller."$WIFI".enabled)"
		json_add_string "band" "$BAND"
		json_add_string "ssid" "$(uci -q get apcontroller."$WIFI".ssid)"
		json_add_string "encryption" "$(uci -q get apcontroller."$WIFI".encryption)"
		json_add_string "key" "$(uci -q get apcontroller."$WIFI".key)"
		json_add_int "hidden" "$(uci -q get apcontroller."$WIFI".hidden)"
		json_add_int "isolate" "$(uci -q get apcontroller."$WIFI".isolate)"
		json_add_string "network" "$(uci -q get apcontroller."$WIFI".network)"
		json_close_object
	done
done
json_close_array

json_dump > ${BASEPATH}/cmds-${SEC}

USEAS=$(uci -q get apcontroller."$SEC".useadditionalscript)
ERRFILE="${BASEPATH}/sendconfig.err"

for HOST in $HOSTS; do
	enabled=$(uci -q get apcontroller."$HOST".enabled)
	[ "$enabled" -eq 1 ] || continue

	ipaddr=$(uci -q get apcontroller."$HOST".ipaddr)
	[ -z "$ipaddr" ] && continue
	port=$(uci -q get apcontroller."$HOST".port)
	[ -z "$port" ] && port=22
	username=$(uci -q get apcontroller."$HOST".username)
	[ -z "$username" ] && continue
	NAME=$(uci -q get apcontroller."$HOST".name)

	autokeysetup=$(uci -q get apcontroller."$HOST".autokeysetup)
	usekeyfile=$(uci -q get apcontroller."$HOST".usekeyfile)
	keyfile=$(uci -q get apcontroller."$HOST".keyfile)
	[ -n "$keyfile" ] || keyfile="/root/.ssh/id_dropbear"
	if [ "x$autokeysetup" = "x1" ]; then
		keyfile="$(default_keyfile "$HOST")"
		keyauth=1
	else
		keyfile="$(normalize_keyfile "$HOST" "$keyfile")"
		keyauth="$usekeyfile"
	fi
	if ! valid_host "$ipaddr" || ! valid_username "$username" || ! valid_port "$port" || ! valid_keyfile "$keyfile"; then
		log_apcontroller "Failed to send config to ${NAME} (${ipaddr}): invalid SSH configuration."
		continue
	fi

	# Common SSH options for compatibility with older Dropbear/RSA
	SSH_OPTS="-o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=${KNOWN_HOSTS} -o PubkeyAcceptedAlgorithms=+ssh-rsa -o HostKeyAlgorithms=+ssh-rsa -o ConnectTimeout=15"
	SCP_OPTS="-O -B"

	rm -f "$ERRFILE"
	T=1

	if [ "x$keyauth" = "x1" ]; then
		if [ ! -e "$keyfile" ]; then
			log_apcontroller "Failed to send config to ${NAME} (${ipaddr}): Key file '${keyfile}' is missing. Run SSH key setup in LuCI."
		fi

		if [ -e "$keyfile" ]; then
			if command -v dbclient >/dev/null 2>&1 && dropbearkey -y -f "$keyfile" >/dev/null 2>&1; then
				DBCLIENT_OPTS="-q -i ${keyfile} -o BatchMode=yes -o PasswordAuthentication=no -o StrictHostKeyChecking=yes -p ${port} -l ${username}"
				if [ "x$USEAS" = "x1" ]; then
					HOME="$DBCLIENT_HOME" dbclient $DBCLIENT_OPTS "$ipaddr" "cat > /tmp/apcontroller.user && chmod 755 /tmp/apcontroller.user" < /usr/share/apcontroller/apcontroller.user 2>"$ERRFILE" && \
					HOME="$DBCLIENT_HOME" dbclient $DBCLIENT_OPTS "$ipaddr" "cat > /tmp/apcontroller-agent-as && chmod 755 /tmp/apcontroller-agent-as" < /usr/share/apcontroller/apcontroller-agent-as 2>>"$ERRFILE"
					T=$?
				else
					T=0
				fi
				[ "$T" -eq 0 ] && \
				HOME="$DBCLIENT_HOME" dbclient $DBCLIENT_OPTS "$ipaddr" "umask 077; cat > /tmp/cmds-${SEC}" < ${BASEPATH}/cmds-${SEC} 2>>"$ERRFILE" && \
				HOME="$DBCLIENT_HOME" dbclient $DBCLIENT_OPTS "$ipaddr" "cat > /tmp/apcontroller-agent-setconfig && chmod 755 /tmp/apcontroller-agent-setconfig" < /usr/share/apcontroller/apcontroller-agent-setconfig 2>>"$ERRFILE" && \
				HOME="$DBCLIENT_HOME" dbclient $DBCLIENT_OPTS "$ipaddr" "/tmp/apcontroller-agent-setconfig /tmp/cmds-${SEC}" 2>>"$ERRFILE"
				T=$?
			else
				if [ "x$USEAS" = "x1" ]; then
					scp $SCP_OPTS -i "${keyfile}" $SSH_OPTS -P ${port} -- /usr/share/apcontroller/apcontroller.user "${username}@${ipaddr}:/tmp" 2>"$ERRFILE"
					scp $SCP_OPTS -i "${keyfile}" $SSH_OPTS -P ${port} -- /usr/share/apcontroller/apcontroller-agent-as "${username}@${ipaddr}:/tmp" 2>>"$ERRFILE"
				fi
				scp $SCP_OPTS -i "${keyfile}" $SSH_OPTS -P ${port} -- ${BASEPATH}/cmds-${SEC} "${username}@${ipaddr}:/tmp" 2>>"$ERRFILE" && \
				scp $SCP_OPTS -i "${keyfile}" $SSH_OPTS -P ${port} -- /usr/share/apcontroller/apcontroller-agent-setconfig "${username}@${ipaddr}:/tmp" 2>>"$ERRFILE" && \
				ssh -q -i "${keyfile}" $SSH_OPTS -o PreferredAuthentications=publickey -p ${port} -- "${username}@${ipaddr}" "/tmp/apcontroller-agent-setconfig /tmp/cmds-${SEC}" 2>>"$ERRFILE"
				T=$?
			fi
		else
			T=1
		fi
	fi

	if [ "x$keyauth" != "x1" ]; then
		log_apcontroller "Failed to send config to ${NAME} (${ipaddr}): SSH key authentication is required."
		T=1
	fi

	if [ "$T" -ne 0 ]; then
		ERR_MSG=$(tr '\n' ' ' < "$ERRFILE" | sed 's/  */ /g')
		log_apcontroller "Failed to send config to ${NAME} (${ipaddr}): ${ERR_MSG:-unknown error}"
	fi

	if [ -n "$VERBOSE" ]; then
		[ "$T" -eq 0 ] && RET="OK" || RET="ERROR"
		echo "${NAME} (${ipaddr}): ${RET}"
	fi
done

rm -f ${BASEPATH}/cmds-${SEC} "$ERRFILE" 2>/dev/null

exit 0
