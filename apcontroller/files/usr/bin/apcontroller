#!/bin/sh

#
# (c) 2025 Cezary Jackiewicz <cezary@eko.one.pl>
#

BASEPATH="/tmp/apcontroller"
DBCLIENT_HOME="/etc/apcontroller"
KNOWN_HOSTS="${DBCLIENT_HOME}/.ssh/known_hosts"

. /lib/functions.sh

log_apcontroller() {
	logger -t apcontroller "$1"
}

default_keyfile() {
	echo "/etc/apcontroller/keys/id_apc_$1"
}

normalize_keyfile() {
	local keyfile="$2"

	[ -n "$keyfile" ] && echo "$keyfile" || echo "/root/.ssh/id_dropbear"
}

valid_host() {
	[ -n "$1" ] && printf '%s\n' "$1" | grep -Eq '^[A-Za-z0-9._:-]+$'
}

valid_username() {
	[ -n "$1" ] && printf '%s\n' "$1" | grep -Eq '^[A-Za-z0-9._-]+$'
}

valid_port() {
	case "$1" in ""|*[!0-9]*) return 1 ;; esac
	[ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

valid_keyfile() {
	[ -n "$1" ] && printf '%s\n' "$1" | grep -Eq '^(/etc/apcontroller/keys|/root/\.ssh)/[A-Za-z0-9._-]+$'
}

get_data_from_host() {
	local cfg="$1"
	local ipaddr username port autokeysetup usekeyfile keyfile keyauth tmpfile runfile errfile success

	config_get_bool enabled "$cfg" enabled 1
	[ "$enabled" -eq 1 ] || return 0

	config_get ipaddr "$cfg" ipaddr
	config_get name "$cfg" name
	[ -z "$ipaddr" ] && return 0

	config_get username "$cfg" username
	config_get port "$cfg" port 22

	config_get_bool autokeysetup "$cfg" autokeysetup 0
	config_get_bool usekeyfile "$cfg" usekeyfile 0
	config_get keyfile "$cfg" keyfile "/root/.ssh/id_dropbear"
	if [ "$autokeysetup" = "1" ]; then
		keyfile="$(default_keyfile "$cfg")"
		keyauth=1
	else
		keyfile="$(normalize_keyfile "$cfg" "$keyfile")"
		keyauth="$usekeyfile"
	fi
	if ! valid_host "$ipaddr" || ! valid_username "$username" || ! valid_port "$port" || ! valid_keyfile "$keyfile"; then
		log_apcontroller "Host '$cfg' has invalid SSH configuration."
		return 1
	fi

	tmpfile="${BASEPATH}/${ipaddr}-${cfg}"
	runfile="${tmpfile}.new.$$"
	errfile="${BASEPATH}/${ipaddr}-${cfg}.err"
	success=0
	rm -f "$errfile" "$runfile"

	# Common SSH options
	SSH_OPTS="-o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=${KNOWN_HOSTS} -o PubkeyAcceptedAlgorithms=+ssh-rsa -o HostKeyAlgorithms=+ssh-rsa -o ConnectTimeout=10"
	SCP_OPTS="-O -B"

	if [ "$keyauth" = "1" ]; then
		if [ ! -e "$keyfile" ]; then
			log_apcontroller "Host '$cfg' (${ipaddr}) ERROR: Key file '${keyfile}' is missing. Run SSH key setup in LuCI."
		fi

		if [ -e "$keyfile" ]; then
			if command -v dbclient >/dev/null 2>&1 && dropbearkey -y -f "$keyfile" >/dev/null 2>&1; then
				DBCLIENT_OPTS="-q -i ${keyfile} -o BatchMode=yes -o PasswordAuthentication=no -o StrictHostKeyChecking=yes -p ${port} -l ${username}"
				if HOME="$DBCLIENT_HOME" dbclient $DBCLIENT_OPTS "$ipaddr" "cat > /tmp/apcontroller-agent && chmod 755 /tmp/apcontroller-agent" < /usr/share/apcontroller/apcontroller-agent 2>"$errfile" && \
				   HOME="$DBCLIENT_HOME" dbclient $DBCLIENT_OPTS "$ipaddr" "/tmp/apcontroller-agent" >"$runfile" 2>>"$errfile"; then
					success=1
				else
					log_apcontroller "Host '$cfg' (${ipaddr}) dropbear key auth failed: $(tr '\n' ' ' < "$errfile")"
				fi
			else
				if scp $SCP_OPTS -i "${keyfile}" $SSH_OPTS -P "${port}" /usr/share/apcontroller/apcontroller-agent "${username}@${ipaddr}:/tmp" 2>"$errfile" && \
				   ssh -q -i "${keyfile}" $SSH_OPTS -o PreferredAuthentications=publickey -p "${port}" "${username}@${ipaddr}" "/tmp/apcontroller-agent" >"$runfile" 2>>"$errfile"; then
					success=1
				else
					log_apcontroller "Host '$cfg' (${ipaddr}) key auth failed: $(tr '\n' ' ' < "$errfile")"
				fi
			fi
		fi
	fi

	if [ "$keyauth" != "1" ]; then
		log_apcontroller "Host '$cfg' (${ipaddr}) ERROR: SSH key authentication is required."
	fi

	if [ "$success" -eq 1 ] && [ -s "$runfile" ]; then
		mv -f "$runfile" "$tmpfile"
		# Safe awk call
		VAL=$(awk -F: '{print $4}' "$tmpfile" 2>/dev/null)
		NOW=$(date +%s)
		[ -z "$VAL" ] || grep -q "$VAL" "${BASEPATH}/${ipaddr}.txt" 2>/dev/null || echo "$NOW $VAL" >> "${BASEPATH}/${ipaddr}.txt"
	fi
	rm -f "$runfile" "$errfile"
}

mkdir -p "$BASEPATH"
chmod 700 "$BASEPATH"
mkdir -p "$DBCLIENT_HOME/.ssh"
chmod 700 "$DBCLIENT_HOME" "$DBCLIENT_HOME/.ssh"
touch "$KNOWN_HOSTS"
chmod 600 "$KNOWN_HOSTS"
config_load apcontroller
config_foreach get_data_from_host host

exit 0
